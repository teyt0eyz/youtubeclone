# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# Project URL (https://<project-ref>.supabase.co) — NOT a key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key (starts with sb_publishable_ or eyJ...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Secret / service_role key (starts with sb_secret_ or eyJ...).
# Used by scripts/* and admin-elevated server actions. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL — used for OAuth redirects, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
